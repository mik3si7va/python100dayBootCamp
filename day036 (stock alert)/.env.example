# Alpha Vantage API key
STOCK_API_KEY=your_alpha_vantage_api_key

# NewsAPI key
NEWS_API_KEY=your_newsapi_key

# Minimum absolute daily move that triggers a news search
ALERT_THRESHOLD=5

# Keep true while testing. Change to false when you want real SMS messages.
DRY_RUN=true

# Twilio credentials, Messaging Service SID, and recipient number
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Usually begins with MG
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid
# Use E.164 format, e.g. +351...
TWILIO_TO_NUMBER=your_personal_phone_number
