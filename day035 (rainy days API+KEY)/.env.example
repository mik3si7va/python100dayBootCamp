# Copy this file to .env and replace the placeholders with your credentials.
WEATHER_API_KEY = "your_openweathermap_api_key_here"
MY_LAT = your_latitude_here
MY_LON = your_longitude_here

# Twilio credentials for sending SMS notifications
MY_PERSONAL_NUMBER = "your_personal_number_here"
MY_ACCOUNT = "your_account_SID_here"
MY_SID = "your_service_SID_here"
MY_AUTH = "your_AUTH_TOKEN_here"