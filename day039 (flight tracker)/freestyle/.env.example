FLIGHT_API_KEY="your serpapi key here"
# Leave SHEETY empty to use DESTINATIONS instead.
SHEETY=""
SHEETY_TOKEN=""
ORIGIN="FAO"
DESTINATIONS="BCN,MAD,FCO,CDG"
WEEKENDS_AHEAD="4"
# Every route/date pair consumes one search unless SerpApi has a cached result.
MAX_SEARCHES_PER_RUN="4"
MAX_PRICE_EUR="180"
MIN_DEAL_SCORE="0"
MAX_ALERTS="3"
DRY_RUN="true"
# Twilio credentials, Messaging Service SID, and recipient number
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# Usually begins with MG
TWILIO_MESSAGING_SERVICE_SID="your_twilio_messaging_service_sid"
# Use E.164 format, e.g. +351...
TWILIO_TO_NUMBER="your_personal_phone_number"
